---
import "@/styles/global.css";
import CookieBanner from "@/components/CookieBanner.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import {
  defaultLocale,
  localizePath,
  locales,
  toLocale,
  useTranslations,
} from "@/i18n";

interface Props {
  /** Full page title, already translated. */
  title: string;
  /** Meta description, already translated. */
  description: string;
}

const { title, description } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path, site).href;

const canonical = absolute(localizePath(Astro.url.pathname, locale));
const alternates = locales.map((lang) => ({
  lang,
  href: absolute(localizePath(Astro.url.pathname, lang)),
}));
const defaultHref = absolute(localizePath(Astro.url.pathname, defaultLocale));

// Preload the fonts for the page's main script; the rest load on demand.
const script = locale === "el" ? "greek" : "latin";
const preloadFonts = [
  `/fonts/inter-${script}-wght-normal.woff2`,
  `/fonts/source-serif-4-${script}-wght-normal.woff2`,
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("skip.link")}
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
