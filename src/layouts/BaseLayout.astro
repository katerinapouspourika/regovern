---
import "@/styles/global.css";
import CookieBanner from "@/components/CookieBanner.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import {
  defaultLocale,
  localizePath,
  locales,
  toLocale,
  useTranslations,
  type Locale,
} from "@/i18n";

interface Props {
  /** Full page title, already translated. */
  title: string;
  /** Meta description, already translated. */
  description: string;
  /** For pages that must not be indexed or linked as alternates (404). */
  noindex?: boolean;
  /**
   * The page's real translations, as localised paths, for pages that do not
   * exist in every language (blog posts). Defaults to the same path in each
   * language.
   */
  alternates?: Partial<Record<Locale, string>>;
  /**
   * Language-neutral path the language switcher uses for a language missing
   * from `alternates`, such as "/blog/".
   */
  languageFallback?: string;
}

const {
  title,
  description,
  noindex = false,
  alternates: alternatePaths,
  languageFallback = "/",
} = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path, site).href;

const canonical = absolute(localizePath(Astro.url.pathname, locale));
const pathIn = (lang: Locale): string | undefined =>
  alternatePaths
    ? alternatePaths[lang]
    : localizePath(Astro.url.pathname, lang);

const alternates = locales.flatMap((lang) => {
  const path = pathIn(lang);
  return path ? [{ lang, href: absolute(path) }] : [];
});
const defaultHref =
  alternates.find(({ lang }) => lang === defaultLocale)?.href ??
  alternates[0]?.href;
const languageHrefs = Object.fromEntries(
  locales.map((lang) => [
    lang,
    pathIn(lang) ?? localizePath(languageFallback, lang),
  ]),
) as Record<Locale, string>;

// Preload the fonts for the page's main script; the rest load on demand.
const script = locale === "el" ? "greek" : "latin";
const preloadFonts = [
  `/fonts/inter-${script}-wght-normal.woff2`,
  `/fonts/source-serif-4-${script}-wght-normal.woff2`,
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map(({ lang, href }) => (
          <link rel="alternate" hreflang={lang} href={href} />
        ))}
        {defaultHref && (
          <link rel="alternate" hreflang="x-default" href={defaultHref} />
        )}
      </>
    )}
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("skip.link")}
    </a>
    <Header languageHrefs={languageHrefs} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
