---
/*
 * Optional eyebrow label, heading and optional subtitle at the top of a
 * section. `tone="light"` is for dark backgrounds.
 */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Id for the heading, so the section can use aria-labelledby. */
  id?: string;
  align?: "start" | "center";
  tone?: "dark" | "light";
}

const {
  eyebrow,
  title,
  subtitle,
  id,
  align = "start",
  tone = "dark",
} = Astro.props;
---

<header class:list={["section-heading", align, tone]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 44rem;
    margin-block-end: var(--space-12);
  }

  .center {
    margin-inline: auto;
    text-align: center;
  }

  .eyebrow {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-teal-700);
    letter-spacing: 0.04em;
  }

  .subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }

  .light {
    h2 {
      color: var(--color-white);
    }

    .eyebrow {
      color: var(--color-teal-200);
    }

    .subtitle {
      color: var(--color-on-dark);
    }
  }
</style>
