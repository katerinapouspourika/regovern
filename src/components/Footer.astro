---
import { Image } from "astro:assets";
import logo from "@/assets/brand/logo-reversed.png";
import Icon from "@/components/Icon.astro";
import { company, emailHref, phoneHref } from "@/data/company";
import { legalNav, mainNav } from "@/data/navigation";
import { localizePath, toLocale, useTranslations } from "@/i18n";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container columns">
    <div class="about">
      <a href={localizePath("/", locale)}>
        <Image
          src={logo}
          alt={t("header.home.label")}
          width={180}
          densities={[1, 2]}
        />
      </a>
      <p>{t("footer.about")}</p>
    </div>

    <nav aria-labelledby="footer-nav-heading">
      <h2 id="footer-nav-heading">{t("footer.nav")}</h2>
      <ul class="links">
        {mainNav.map(({ label, path }) => (
          <li>
            <a href={localizePath(path, locale)}>{t(label)}</a>
          </li>
        ))}
      </ul>
    </nav>

    <section aria-labelledby="footer-contact-heading">
      <h2 id="footer-contact-heading">{t("footer.contact")}</h2>
      <ul class="links contact">
        <li>
          <Icon name="phone" size={18} />
          <span class="visually-hidden">{t("contact.phone")}:</span>
          <a href={phoneHref}>{company.phone}</a>
        </li>
        <li>
          <Icon name="mail" size={18} />
          <span class="visually-hidden">{t("contact.email")}:</span>
          <a href={emailHref}>{company.email}</a>
        </li>
        <li>
          <Icon name="map-pin" size={18} />
          <span class="visually-hidden">{t("contact.address")}:</span>
          <address>{t("company.address")}</address>
        </li>
        <li>
          <Icon name="clock" size={18} />
          <span class="visually-hidden">{t("contact.hours")}:</span>
          {t("company.hours")}
        </li>
      </ul>
    </section>

    <section aria-labelledby="footer-legal-heading">
      <h2 id="footer-legal-heading">{t("footer.legal")}</h2>
      <p class="legal-name">{t("company.legalName")}</p>
      <dl class="details">
        <dt>{t("company.gemi")}</dt>
        <dd>{company.gemi}</dd>
        <dt>{t("company.vat")}</dt>
        <dd>{company.vat}</dd>
      </dl>
    </section>
  </div>

  <div class="container">
    <div class="bottom">
      <p>
        © {year} {t("company.legalName")} {t("footer.copyright")}
      </p>
      <nav aria-label={t("footer.legalNav")}>
        <ul class="legal-links">
          {legalNav.map(({ label, path }) => (
            <li>
              <a href={localizePath(path, locale)}>{t(label)}</a>
            </li>
          ))}
          <li>
            {/* Shown by the cookie banner script; without JavaScript there is nothing to change. */}
            <button type="button" data-cookie-settings hidden>
              {t("footer.cookieSettings")}
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --color-focus: var(--color-gold-300);

    padding-block: var(--space-16) var(--space-8);
    font-size: var(--font-size-sm);
    color: var(--color-surface);
    background: var(--color-navy-900);
  }

  a,
  button {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--color-gold-300);
      text-decoration: underline;
    }
  }

  h2 {
    margin-block-end: var(--space-4);
    font-size: var(--font-size-lg);
    color: var(--color-white);
  }

  .columns {
    display: grid;
    gap: var(--space-12) var(--space-8);

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 64rem) {
      grid-template-columns: 1.5fr 1fr 1.5fr 1fr;
    }
  }

  .about {
    display: grid;
    gap: var(--space-4);
    align-content: start;

    p {
      max-inline-size: 36ch;
    }
  }

  .links {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .contact li {
    display: flex;
    gap: var(--space-3);
    align-items: start;

    svg {
      flex-shrink: 0;
      margin-block-start: 0.125rem;
      color: var(--color-gold-500);
    }
  }

  address {
    font-style: normal;
  }

  .details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-3);
    margin: 0;

    dd {
      margin: 0;
    }

    dt {
      color: var(--color-gold-300);
    }
  }

  .legal-name {
    margin-block-end: var(--space-2);
    font-weight: 600;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    justify-content: space-between;
    padding-block-start: var(--space-8);
    margin-block-start: var(--space-12);
    border-block-start: 1px solid var(--color-navy-700);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  button {
    padding: 0;
    cursor: pointer;
    background: none;
    border: 0;
  }

  button[hidden] {
    display: none;
  }
</style>
