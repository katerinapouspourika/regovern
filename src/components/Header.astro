---
import { Image } from "astro:assets";
import wordmark from "@/assets/brand/wordmark.png";
import Icon from "@/components/Icon.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { mainNav } from "@/data/navigation";
import { localizePath, stripLocale, toLocale, useTranslations } from "@/i18n";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const currentPath = stripLocale(Astro.url.pathname);

/** Home matches only itself; other items also match their sub-pages (blog posts). */
function isCurrent(path: string): boolean {
  return path === "/" ? currentPath === "/" : currentPath.startsWith(path);
}
---

{/* Floats over the top of each page's hero; the navigation sits in a glass panel. */}
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={localizePath("/", locale)}>
      <Image
        src={wordmark}
        alt={t("header.home.label")}
        height={36}
        densities={[1, 2]}
        loading="eager"
      />
    </a>

    {/* The mobile menu is a native popover: no JavaScript, Esc and outside clicks close it. */}
    <button class="menu-button glass" type="button" popovertarget="site-menu">
      <Icon name="menu" size={22} />
      {t("menu.open")}
    </button>

    <div class="menu glass" id="site-menu" popover>
      <button
        class="close"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
      >
        <Icon name="close" size={24} />
        <span class="visually-hidden">{t("menu.close")}</span>
      </button>
      <nav aria-label={t("nav.label")}>
        <ul class="nav-list">
          {mainNav.map(({ label, path }) => (
            <li>
              <a
                href={localizePath(path, locale)}
                aria-current={isCurrent(path) ? "page" : undefined}
              >
                {t(label)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <LanguageSwitcher />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
  }

  .inner {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    min-block-size: var(--header-height);
    padding-block: var(--space-4);
  }

  .brand {
    flex-shrink: 0;

    img {
      inline-size: auto;
      block-size: 1.75rem;

      @media (width >= 48rem) {
        block-size: 2.25rem;
      }
    }
  }

  /* Frosted white panel, as in the reference design's navigation bar. */
  .glass {
    background: rgb(255 255 255 / 80%);
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .menu-button {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: var(--space-4);
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;

    @media (width >= 64rem) {
      display: none;
    }
  }

  .close {
    display: inline-grid;
    place-items: center;
    justify-self: end;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    color: var(--color-ink);
    cursor: pointer;
    background: none;
    border: 0;

    @media (width >= 64rem) {
      display: none;
    }
  }

  /* Mobile: a card that drops down over the page. */
  .menu {
    &:popover-open {
      display: grid;
      gap: var(--space-6);
      justify-items: start;
      inline-size: auto;
      max-inline-size: none;
      max-block-size: calc(100dvh - 2 * var(--space-3));
      padding: var(--space-4) var(--space-6) var(--space-8);
      margin: 0;
      overflow-y: auto;
      color: var(--color-text);
      background: var(--color-white);
      box-shadow: var(--shadow-raised);
      inset: var(--space-3) var(--space-3) auto;
    }

    &::backdrop {
      background: rgb(38 44 47 / 40%);
    }

    /* Desktop: always visible as the glass bar, whatever the popover state. */
    @media (width >= 64rem) {
      position: static;
      display: flex;
      gap: var(--space-6);
      align-items: center;
      inline-size: auto;
      padding: var(--space-1) var(--space-2) var(--space-1) var(--space-8);
      margin: 0;
      overflow: visible;
      color: inherit;
    }
  }

  .nav-list {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    margin: 0;
    list-style: none;

    @media (width >= 64rem) {
      display: flex;
      gap: var(--space-8);
    }

    a {
      display: block;
      padding-block: var(--space-2);
      font-size: var(--font-size-lg);
      font-weight: 500;
      color: var(--color-ink);
      text-decoration: none;
      border-block-end: 2px solid transparent;
      transition: border-color var(--duration-fast);

      @media (width >= 64rem) {
        font-size: var(--font-size-base);
      }

      &:hover,
      &[aria-current="page"] {
        border-color: currentcolor;
      }
    }
  }
</style>
