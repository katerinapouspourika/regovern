---
import Button from "@/components/Button.astro";
import { localizePath, toLocale, useTranslations } from "@/i18n";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="panel">
      <div>
        <h2 id="cta-title">{t("cta.title")}</h2>
        <p>{t("cta.text")}</p>
      </div>
      <Button href={localizePath("/contact/", locale)} variant="accent">
        {t("cta.button")}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-24);
  }

  .panel {
    --color-focus: var(--color-teal-200);

    display: grid;
    gap: var(--space-8);
    justify-items: start;
    padding: var(--space-12) var(--space-8);
    color: var(--color-on-dark);
    background: var(--color-slate-800);
    border-block-end: 2px solid var(--color-bronze-500);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;

    @media (width >= 48rem) {
      grid-template-columns: 1fr auto;
      gap: var(--space-12);
      align-items: center;
      padding: var(--space-16);
    }
  }

  h2 {
    margin-block-end: var(--space-4);
    color: var(--color-white);
  }

  p {
    max-inline-size: 48ch;
    font-size: var(--font-size-lg);
  }
</style>
