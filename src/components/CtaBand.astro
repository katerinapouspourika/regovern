---
import Button from "@/components/Button.astro";
import { localizePath, toLocale, useTranslations } from "@/i18n";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container inner">
    <div>
      <h2 id="cta-title">{t("cta.title")}</h2>
      <p>{t("cta.text")}</p>
    </div>
    <Button href={localizePath("/contact/", locale)}>{t("cta.button")}</Button>
  </div>
</section>

<style>
  .cta {
    --color-focus: var(--color-gold-300);

    padding-block: var(--space-16);
    color: var(--color-surface);
    background:
      radial-gradient(circle at 85% 0%, rgb(180 140 73 / 25%), transparent 45%),
      var(--color-navy-700);
  }

  .inner {
    display: grid;
    gap: var(--space-6);
    justify-items: start;

    @media (width >= 48rem) {
      grid-template-columns: 1fr auto;
      gap: var(--space-12);
      align-items: center;
    }
  }

  h2 {
    margin-block-end: var(--space-3);
    color: var(--color-white);
  }

  p {
    max-inline-size: 48ch;
    font-size: var(--font-size-lg);
  }
</style>
