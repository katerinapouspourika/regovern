---
/*
 * Banner at the top of inner pages: breadcrumb, title and subtitle over the
 * skyline photo. The site header floats over its top.
 */
import { Image } from "astro:assets";
import skyline from "@/assets/placeholders/skyline.jpg";
import { localizePath, toLocale, useTranslations } from "@/i18n";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="page-hero" aria-labelledby="page-title">
  {/* TODO(content): replace with a real photo (see src/assets/placeholders/README.md). */}
  <Image
    class="background"
    src={skyline}
    alt=""
    widths={[768, 1280, 1920, 2400]}
    sizes="100vw"
    loading="eager"
  />
  <div class="container inner">
    <nav aria-label={t("breadcrumb.label")}>
      <ol class="breadcrumb">
        <li>
          <a href={localizePath("/", locale)}>{t("nav.home")}</a>
        </li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <h1 id="page-title">{title}</h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    padding-block: calc(var(--header-height) + var(--space-16)) var(--space-16);

    /* Light wash on the left keeps the dark text readable over the photo. */
    &::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: "";
      background: linear-gradient(
        90deg,
        rgb(245 247 248 / 92%) 0%,
        rgb(245 247 248 / 70%) 45%,
        rgb(245 247 248 / 10%) 80%
      );
    }

    @media (width >= 64rem) {
      padding-block: calc(var(--header-height) + var(--space-24))
        var(--space-24);
    }
  }

  .background {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  .inner {
    display: grid;
    gap: var(--space-4);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    list-style: none;

    li + li::before {
      margin-inline-end: var(--space-2);
      content: "/";
    }

    a {
      color: var(--color-teal-700);
    }
  }

  h1 {
    max-inline-size: 18ch;
  }

  .subtitle {
    max-inline-size: 52ch;
    font-size: var(--font-size-lg);
    color: var(--color-ink);
  }
</style>
