---
/*
 * A link styled as a button. Variants:
 * - primary: charcoal fill with white text (light backgrounds and photos)
 * - accent: teal fill with white text
 * - outline-dark: charcoal outline, for light backgrounds
 * - outline-light: white outline, for dark backgrounds
 */
interface Props {
  href: string;
  variant?: "primary" | "accent" | "outline-dark" | "outline-light";
}

const { href, variant = "primary" } = Astro.props;
---

<a class:list={["button", variant]} href={href}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
    min-block-size: 3rem;
    padding: var(--space-3) var(--space-8);
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition:
      background-color var(--duration-fast),
      border-color var(--duration-fast),
      color var(--duration-fast);
  }

  .primary {
    color: var(--color-white);
    background: var(--color-slate-800);
    border-color: var(--color-slate-700);
    box-shadow: 0 0.5rem 1.25rem rgb(38 44 47 / 20%);

    &:hover {
      background: var(--color-ink);
    }
  }

  .accent {
    color: var(--color-white);
    background: var(--color-teal-700);

    &:hover {
      background: var(--color-ink);
    }
  }

  .outline-dark {
    color: var(--color-ink);
    border-color: var(--color-ink);

    &:hover {
      color: var(--color-white);
      background: var(--color-ink);
    }
  }

  .outline-light {
    color: var(--color-white);
    border-color: rgb(255 255 255 / 70%);

    &:hover {
      color: var(--color-ink);
      background: var(--color-white);
    }
  }
</style>
