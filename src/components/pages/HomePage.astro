---
/*
 * Home page body, shared by the Greek (src/pages/index.astro) and English
 * (src/pages/en/index.astro) routes. The language comes from the URL.
 * Layout follows the client's reference design 1 (docs/brief.md).
 */
import { Image } from "astro:assets";
import facadeImage from "@/assets/placeholders/hero.jpg";
import officeImage from "@/assets/placeholders/office.jpg";
import skylineImage from "@/assets/placeholders/skyline.jpg";
import Button from "@/components/Button.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon, { type IconName } from "@/components/Icon.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import StatCounter from "@/components/StatCounter.astro";
import { services } from "@/data/services";
import {
  formatNumber,
  localizePath,
  toLocale,
  useTranslations,
  type UiKey,
} from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, postPath } from "@/utils/blog";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

// TODO(content): real figures.
const stats: readonly { value: number; label: UiKey }[] = [
  { value: 15, label: "home.stats.years" },
  { value: 350, label: "home.stats.audits" },
  { value: 80, label: "home.stats.clients" },
];

const steps: readonly { icon: IconName; title: UiKey; text: UiKey }[] = [
  {
    icon: "message",
    title: "home.process.consultation.title",
    text: "home.process.consultation.text",
  },
  {
    icon: "target",
    title: "home.process.planning.title",
    text: "home.process.planning.text",
  },
  {
    icon: "clipboard-check",
    title: "home.process.fieldwork.title",
    text: "home.process.fieldwork.text",
  },
  {
    icon: "file-text",
    title: "home.process.reporting.title",
    text: "home.process.reporting.text",
  },
];

const latestPosts = (await getPosts(locale)).slice(0, 2);
---

<BaseLayout
  title={t("home.meta.title")}
  description={t("home.meta.description")}
>
  <section class="hero" aria-labelledby="hero-title">
    {/* TODO(content): replace with a real photo (see src/assets/placeholders/README.md). */}
    <Image
      class="hero-image"
      src={skylineImage}
      alt=""
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero-inner">
      <h1 id="hero-title">
        {t("home.hero.title.before")}{" "}
        <span class="highlight">{t("home.hero.title.highlight")}</span>
      </h1>
      <p class="tagline">{t("home.hero.eyebrow")}</p>
      <div class="actions">
        <Button href={localizePath("/services/", locale)}>
          {t("home.hero.services")}
        </Button>
        <Button href={localizePath("/contact/", locale)} variant="outline-dark">
          {t("home.hero.contact")}
        </Button>
      </div>
    </div>
  </section>

  {/* Three panels that overlap the bottom of the hero on large screens. */}
  <div class="panels">
    <div class="container panel-grid">
      <section class="panel dark about" aria-labelledby="about-title">
        <h2 id="about-title">{t("home.about.title")}</h2>
        <p>{t("home.about.text")}</p>
        <a class="more" href={localizePath("/about/", locale)}>
          {t("home.overview.link")}
          <Icon name="arrow-right" size={18} />
        </a>
        {/* TODO(content): replace with a real photo. */}
        <Image
          class="about-image"
          src={facadeImage}
          alt=""
          widths={[400, 800]}
          sizes="(min-width: 64rem) 22rem, 100vw"
        />
      </section>

      <section class="panel light expertise" aria-labelledby="expertise-title">
        <h2 id="expertise-title">{t("home.expertise.title")}</h2>
        <ul class="expertise-grid">
          {services.map((service) => (
            <li>
              <Icon name={service.icon} size={30} />
              <h3>
                <a href={`${localizePath("/services/", locale)}#${service.id}`}>
                  {t(service.title)}
                </a>
              </h3>
              <p>{t(service.summary)}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="panel dark recent" aria-labelledby="recent-title">
        <h2 id="recent-title">{t("home.blog.title")}</h2>
        <ul class="recent-list">
          {latestPosts.map((post) => (
            <li>
              <Image
                src={post.data.cover}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 64rem) 20rem, 100vw"
              />
              <a href={localizePath(postPath(post), locale)}>
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
        <a class="more" href={localizePath("/blog/", locale)}>
          {t("home.blog.all")}
          <Icon name="arrow-right" size={18} />
        </a>
      </section>
    </div>
  </div>

  <section class="overview" aria-labelledby="overview-title">
    <div class="container">
      <div class="sheet">
        <div class="overview-text">
          <SectionHeading
            id="overview-title"
            eyebrow={t("home.overview.eyebrow")}
            title={t("home.overview.title")}
          />
          <p>{t("home.overview.text")}</p>
          <dl class="stats" aria-label={t("home.stats.label")}>
            {stats.map(({ value, label }) => (
              <StatCounter
                value={`+${formatNumber(value, locale)}`}
                label={t(label)}
              />
            ))}
          </dl>
          <p>{t("home.overview.more")}</p>
          <Button
            href={localizePath("/services/", locale)}
            variant="outline-dark"
          >
            {t("home.overview.services")}
          </Button>
        </div>
        {/* TODO(content): replace with a real photo (see src/assets/placeholders/README.md). */}
        <Image
          class="overview-image"
          src={officeImage}
          alt={t("home.overview.imageAlt")}
          widths={[480, 960]}
          sizes="(min-width: 64rem) 32rem, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="process" aria-labelledby="process-title">
    <div class="container">
      <SectionHeading
        id="process-title"
        eyebrow={t("home.process.eyebrow")}
        title={t("home.process.title")}
        subtitle={t("home.process.subtitle")}
      />
      <ol class="steps">
        {steps.map(({ icon, title, text }) => (
          <li>
            <span class="step-icon">
              <Icon name={icon} size={28} />
            </span>
            <h3>{t(title)}</h3>
            <p>{t(text)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  ul,
  ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* Hero: bright skyline photo with a light wash behind the text. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-block-size: min(46rem, 100svh);
    padding-block: calc(var(--header-height) + var(--space-16)) var(--space-16);

    &::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: "";
      background: linear-gradient(
        90deg,
        rgb(245 247 248 / 88%) 0%,
        rgb(245 247 248 / 60%) 40%,
        rgb(245 247 248 / 0%) 70%
      );
    }

    /* Leave room for the panels that overlap the bottom edge. */
    @media (width >= 64rem) {
      min-block-size: 52rem;
      padding-block-end: calc(var(--space-32) + var(--space-16));
    }
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  .hero-inner {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  h1 {
    max-inline-size: 14ch;
  }

  .highlight {
    color: var(--color-teal-500);
  }

  .tagline {
    font-size: var(--font-size-xl);
    color: var(--color-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  /* Panels: dark, light (raised) and dark, as in the reference design. */
  .panels {
    /* Positioned so the panels paint above the hero they overlap. */
    position: relative;
    z-index: 1;
    padding-block: var(--space-12) 0;
    background: var(--color-mist-500);

    @media (width >= 64rem) {
      padding-block: 0;
      background: linear-gradient(
        to bottom,
        transparent 0 calc(var(--space-32) + var(--space-8)),
        var(--color-mist-500) calc(var(--space-32) + var(--space-8))
      );
    }
  }

  .panel-grid {
    display: grid;
    gap: var(--space-6);

    @media (width >= 64rem) {
      grid-template-columns: 1fr 1.15fr 1fr;
      gap: 0;
      align-items: start;
      margin-block-start: calc(-1 * (var(--space-32) + var(--space-8)));
    }
  }

  .panel {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-8);

    h2 {
      font-size: var(--font-size-2xl);
    }
  }

  .dark {
    --color-focus: var(--color-teal-200);

    color: var(--color-on-dark);
    background: var(--color-slate-800);

    h2 {
      color: var(--color-white);
    }

    @media (width >= 64rem) {
      min-block-size: 30rem;
    }
  }

  .light {
    position: relative;
    z-index: 1;
    padding: var(--space-12) var(--space-8);
    background: var(--color-mist-200);
    border-block-end: 2px solid var(--color-bronze-500);
    box-shadow: var(--shadow-raised);

    @media (width >= 64rem) {
      margin-block: calc(-1 * var(--space-6)) calc(-1 * var(--space-12));
    }
  }

  .more {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-self: start;
    font-weight: 600;
    color: var(--color-teal-200);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .about-image {
    inline-size: calc(100% + 2 * var(--space-8));
    max-inline-size: none;
    margin: var(--space-4) calc(-1 * var(--space-8)) calc(-1 * var(--space-8));
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* Two-by-two grid of services with hairline dividers. */
  .expertise-grid {
    display: grid;
    margin-block-start: var(--space-4);

    @media (width >= 30rem) {
      grid-template-columns: 1fr 1fr;
    }

    li {
      display: grid;
      gap: var(--space-2);
      align-content: start;
      padding: var(--space-6) var(--space-4);
      color: var(--color-teal-500);
      border-block-start: 1px solid rgb(42 44 46 / 15%);
    }

    h3 {
      font-family: var(--font-sans);
      font-size: var(--font-size-base);
      font-weight: 700;
      line-height: 1.3;
    }

    a {
      color: var(--color-ink);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }

    p {
      font-size: var(--font-size-sm);
      color: var(--color-text-muted);
    }
  }

  @media (width >= 30rem) {
    .expertise-grid li:nth-child(-n + 2) {
      border-block-start: 0;
    }

    .expertise-grid li:nth-child(even) {
      border-inline-start: 1px solid rgb(42 44 46 / 15%);
    }
  }

  .recent-list {
    display: grid;
    gap: var(--space-4);

    li {
      position: relative;
      overflow: hidden;
      border-block-end: 2px solid var(--color-bronze-500);
    }

    img {
      inline-size: 100%;
      aspect-ratio: 16 / 7;
      object-fit: cover;
    }

    /* Caption bar under the photo; the link covers the whole item. */
    a {
      display: block;
      padding: var(--space-3) var(--space-4);
      font-size: var(--font-size-sm);
      color: var(--color-white);
      text-decoration: none;
      background: var(--color-slate-700);

      &::after {
        position: absolute;
        inset: 0;
        content: "";
      }

      &:hover {
        text-decoration: underline;
      }
    }
  }

  /* Company overview: a white sheet on the blue-grey backdrop. */
  .overview {
    padding-block: var(--space-24);
    background: var(--color-mist-500);

    @media (width >= 64rem) {
      padding-block: var(--space-32) var(--space-24);
    }
  }

  .sheet {
    display: grid;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-12) var(--space-6);
    background: var(--color-white);
    border-block-end: 2px solid var(--color-bronze-500);

    @media (width >= 48rem) {
      padding: var(--space-16);
    }

    @media (width >= 64rem) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
      padding: var(--space-24) var(--space-16);
    }
  }

  .overview-text {
    display: grid;
    gap: var(--space-6);
    justify-items: start;

    > :global(.section-heading) {
      margin-block-end: 0;
    }

    > p {
      max-inline-size: 60ch;
      color: var(--color-text-muted);
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: var(--space-8);
    inline-size: 100%;
    margin-block: var(--space-4);
  }

  .overview-image {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* How we work: four steps joined by a line on large screens. */
  .process {
    padding-block: var(--space-32) var(--space-8);
  }

  .steps {
    display: grid;
    gap: var(--space-12) var(--space-8);

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(4, 1fr);
    }

    li {
      position: relative;
      display: grid;
      gap: var(--space-3);
      align-content: start;
    }

    @media (width >= 64rem) {
      li:not(:last-child)::after {
        position: absolute;
        inset-block-start: 2.25rem;
        inset-inline: calc(4.5rem + var(--space-4)) calc(-1 * var(--space-4));
        block-size: 1px;
        content: "";
        background: var(--color-mist-500);
      }
    }

    h3 {
      margin-block-start: var(--space-3);
      font-family: var(--font-sans);
      font-size: var(--font-size-lg);
      font-weight: 700;
    }

    p {
      color: var(--color-text-muted);
    }
  }

  .step-icon {
    display: grid;
    place-items: center;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    color: var(--color-ink);
    background: var(--color-mist-200);
    border-radius: 50%;
  }
</style>
