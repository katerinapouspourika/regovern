---
/*
 * Services page body, shared by src/pages/services.astro (Greek) and
 * src/pages/en/services.astro (English).
 */
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { services } from "@/data/services";
import { toLocale, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout
  title={t("services.meta.title")}
  description={t("services.meta.description")}
>
  <PageHero
    title={t("services.hero.title")}
    subtitle={t("services.hero.subtitle")}
  />

  <section class="overview" aria-labelledby="overview-title">
    <div class="container">
      <h2 id="overview-title" class="visually-hidden">
        {t("services.overview.title")}
      </h2>
      <ul class="card-grid">
        {services.map((service) => (
          <li>
            <ServiceCard
              icon={service.icon}
              title={t(service.title)}
              summary={t(service.summary)}
              href={`#${service.id}`}
              linkText={t("services.more")}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {services.map((service, index) => (
    <section
      class:list={["detail", { alt: index % 2 === 1 }]}
      id={service.id}
      aria-labelledby={`${service.id}-title`}
    >
      <div class="container detail-inner">
        <div class="detail-icon">
          <Icon name={service.icon} size={48} />
        </div>
        <div class="detail-text">
          <SectionHeading
            id={`${service.id}-title`}
            eyebrow={String(index + 1).padStart(2, "0")}
            title={t(service.title)}
            align="start"
          />
          {/* TODO(content): real service description. */}
          <p>{t(service.description)}</p>
        </div>
        <div class="detail-points">
          <h3>{t("services.offers")}</h3>
          <ul>
            {service.points.map((point) => (
              <li>{t(point)}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <CtaBand />
</BaseLayout>

<style>
  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* White cards on the blue-grey backdrop, as on the home page. */
  .overview {
    padding-block: var(--space-24);
    background: var(--color-mist-500);
  }

  .card-grid {
    display: grid;
    gap: var(--space-6);

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(4, 1fr);
    }

    li {
      display: grid;
    }
  }

  .detail {
    padding-block: var(--space-24);

    @media (width >= 64rem) {
      padding-block: var(--space-32);
    }
  }

  .alt {
    background: var(--color-surface);
  }

  .detail-inner {
    display: grid;
    gap: var(--space-8);
    align-items: start;

    @media (width >= 64rem) {
      grid-template-columns: auto 3fr 2fr;
      gap: var(--space-12);
    }
  }

  .detail-icon {
    display: grid;
    place-items: center;
    inline-size: 5rem;
    block-size: 5rem;
    color: var(--color-teal-500);
    background: var(--color-mist-200);
    border-radius: 50%;
  }

  .detail-text {
    display: grid;
    gap: var(--space-6);

    > :global(.section-heading) {
      margin-block-end: 0;
    }

    p {
      max-inline-size: 65ch;
      color: var(--color-text-muted);
    }
  }

  /* Dark panel with bronze base line, as in the reference design. */
  .detail-points {
    padding: var(--space-8);
    color: var(--color-on-dark);
    background: var(--color-slate-800);
    border-block-end: 2px solid var(--color-bronze-500);

    h3 {
      margin-block-end: var(--space-4);
      color: var(--color-white);
    }

    li {
      display: flex;
      gap: var(--space-3);
      padding-block: var(--space-2);

      &::before {
        flex-shrink: 0;
        inline-size: 0.5rem;
        block-size: 0.5rem;
        margin-block-start: 0.6em;
        content: "";
        background: var(--color-teal-200);
        border-radius: 50%;
      }
    }
  }
</style>
