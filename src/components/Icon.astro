---
/*
 * Thin line icons on a 24×24 grid, drawn with the current text colour.
 * Decorative by default: the text next to an icon carries the meaning.
 * Phone path from Feather Icons (MIT licence).
 */
export type IconName =
  | "phone"
  | "mail"
  | "clock"
  | "map-pin"
  | "menu"
  | "close"
  | "arrow-right"
  | "clipboard-check"
  | "shield"
  | "scale"
  | "landmark"
  | "compass"
  | "award"
  | "lock"
  | "target"
  | "message"
  | "file-text"
  | "pause"
  | "play";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "phone" && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === "map-pin" && (
    <>
      <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "message" && <path d="M4 5h16v11H10l-5 4v-4H4z" />}
  {name === "pause" && <path d="M9 6v12M15 6v12" />}
  {name === "play" && <path d="M8 5v14l11-7z" />}
  {name === "file-text" && <path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6" />}
  {name === "clipboard-check" && (
    <>
      <rect x="5" y="4" width="14" height="17" rx="2" />
      <path d="M9 4V3h6v1M9 13l2 2 4-4" />
    </>
  )}
  {name === "shield" && (
    <>
      <path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z" />
      <path d="M12 8v4M12 15.5v.5" />
    </>
  )}
  {name === "scale" && (
    <path d="M12 4v16M8 20h8M4 8h16M4 8l-2.5 6a2.5 2.5 0 0 0 5 0zM20 8l-2.5 6a2.5 2.5 0 0 0 5 0z" />
  )}
  {name === "landmark" && (
    <path d="M3 21h18M5 18v-7M9.5 18v-7M14.5 18v-7M19 18v-7M3 9l9-6 9 6z" />
  )}
  {name === "compass" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m15.5 8.5-2 5-5 2 2-5z" />
    </>
  )}
  {name === "award" && (
    <>
      <circle cx="12" cy="9" r="5.5" />
      <path d="m8.5 13.5-1.5 7.5 5-2.5 5 2.5-1.5-7.5" />
    </>
  )}
  {name === "lock" && (
    <>
      <rect x="5" y="11" width="14" height="10" rx="2" />
      <path d="M8 11V8a4 4 0 0 1 8 0v3" />
    </>
  )}
  {name === "target" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="5" />
      <circle cx="12" cy="12" r="1" />
    </>
  )}
</svg>
