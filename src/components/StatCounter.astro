---
interface Props {
  /** Already formatted for the page's language, such as "+350". */
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="stat">
  <dt>{label}</dt>
  <dd>{value}</dd>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  dt {
    max-inline-size: 12ch;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }

  /* The figure reads after its label but shows above it. */
  dd {
    order: -1;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-3xl);
    font-weight: 400;
    line-height: 1;
    color: var(--color-teal-500);
  }
</style>
