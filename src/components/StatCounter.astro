---
interface Props {
  /** Already formatted for the page's language, such as "+350". */
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="stat">
  <dt>{label}</dt>
  <dd>{value}</dd>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--color-gold-500);
  }

  dt {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* The figure reads after its label but shows above it. */
  dd {
    order: -1;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--font-size-3xl);
    font-weight: 600;
    line-height: 1;
    color: var(--color-navy-900);
  }
</style>
