---
import { localizePath, toLocale, useTranslations } from "@/i18n";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

{/*
  Hidden until the script finds no stored choice. The site only sets strictly
  necessary cookies today; the banner exists so analytics can later be added
  behind consent (see src/scripts/consent.ts).
*/}
<section
  class="cookie-banner"
  aria-labelledby="cookie-banner-title"
  data-cookie-banner
  hidden
>
  <div class="container inner">
    <div class="text">
      <h2 id="cookie-banner-title">{t("cookies.title")}</h2>
      <p>
        {t("cookies.text")}{" "}
        <a href={localizePath("/cookies/", locale)}>{t("cookies.policy")}</a>
      </p>
    </div>
    <div class="actions">
      <button type="button" class="button" data-consent="rejected">
        {t("cookies.reject")}
      </button>
      <button type="button" class="button" data-consent="accepted">
        {t("cookies.accept")}
      </button>
    </div>
  </div>
</section>

<script>
  import { getConsent, setConsent, type Consent } from "@/scripts/consent";

  const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");
  const settings = document.querySelector<HTMLButtonElement>(
    "[data-cookie-settings]",
  );

  if (banner) {
    banner.hidden = getConsent() !== null;

    banner.addEventListener("click", (event) => {
      const button =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>("[data-consent]")
          : null;
      const choice = button?.dataset.consent;
      if (choice !== "accepted" && choice !== "rejected") return;
      setConsent(choice satisfies Consent);
      banner.hidden = true;
      settings?.focus();
    });

    if (settings) {
      settings.hidden = false;
      settings.addEventListener("click", () => {
        banner.hidden = false;
        banner.querySelector("button")?.focus();
      });
    }
  }
</script>

<style>
  .cookie-banner {
    --color-focus: var(--color-gold-300);

    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    color: var(--color-surface);
    background: var(--color-navy-900);
    border-block-start: 2px solid var(--color-gold-500);
    box-shadow: 0 -0.5rem 2rem rgb(19 40 71 / 25%);

    &[hidden] {
      display: none;
    }
  }

  .inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);

    @media (width >= 48rem) {
      grid-template-columns: 1fr auto;
      gap: var(--space-8);
      align-items: center;
    }
  }

  h2 {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-lg);
    color: var(--color-white);
  }

  p {
    max-inline-size: 70ch;
    font-size: var(--font-size-sm);
  }

  a {
    color: var(--color-gold-300);
  }

  /* Accept and Reject look identical so neither is nudged (GDPR guidance). */
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .button {
    min-block-size: 2.75rem;
    padding-inline: var(--space-6);
    font-weight: 600;
    color: var(--color-navy-900);
    cursor: pointer;
    background: var(--color-gold-500);
    border: 0;
    border-radius: var(--radius);
    transition: background-color var(--duration-fast);

    &:hover {
      background: var(--color-gold-300);
    }
  }
</style>
