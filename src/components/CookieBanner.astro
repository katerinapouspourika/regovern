---
import { localizePath, toLocale, useTranslations } from "@/i18n";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

{/*
  Hidden until the script finds no stored choice. The site only sets strictly
  necessary cookies today; the banner exists so analytics can later be added
  behind consent (see src/scripts/consent.ts).
*/}
<section
  class="cookie-banner"
  aria-labelledby="cookie-banner-title"
  data-cookie-banner
  hidden
>
  <div class="inner">
    <div class="text">
      <h2 id="cookie-banner-title">{t("cookies.title")}</h2>
      <p>
        {t("cookies.text")}{" "}
        <a href={localizePath("/cookies/", locale)}>{t("cookies.policy")}</a>
      </p>
    </div>
    <div class="actions">
      <button type="button" class="button" data-consent="rejected">
        {t("cookies.reject")}
      </button>
      <button type="button" class="button" data-consent="accepted">
        {t("cookies.accept")}
      </button>
    </div>
  </div>
</section>

<script>
  import { getConsent, setConsent, type Consent } from "@/scripts/consent";

  const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");
  const settings = document.querySelector<HTMLButtonElement>(
    "[data-cookie-settings]",
  );

  if (banner) {
    banner.hidden = getConsent() !== null;

    banner.addEventListener("click", (event) => {
      const button =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>("[data-consent]")
          : null;
      const choice = button?.dataset.consent;
      if (choice !== "accepted" && choice !== "rejected") return;
      setConsent(choice satisfies Consent);
      banner.hidden = true;
      settings?.focus();
    });

    if (settings) {
      settings.hidden = false;
      settings.addEventListener("click", () => {
        banner.hidden = false;
        banner.querySelector("button")?.focus();
      });
    }
  }
</script>

<style>
  /* A card floating in the bottom corner, so it covers little of the page. */
  .cookie-banner {
    position: fixed;
    inset: auto var(--space-3) var(--space-3);
    z-index: 20;
    max-inline-size: 30rem;
    color: var(--color-text);
    background: var(--color-white);
    border-block-end: 2px solid var(--color-bronze-500);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: var(--shadow-raised);

    @media (width >= 40rem) {
      inset: auto var(--space-6) var(--space-6) auto;
    }

    &[hidden] {
      display: none;
    }
  }

  .inner {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
  }

  h2 {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-lg);
  }

  p {
    font-size: var(--font-size-sm);
  }

  /* Accept and Reject look identical so neither is nudged (GDPR guidance). */
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .button {
    min-block-size: 2.75rem;
    padding-inline: var(--space-6);
    font-weight: 500;
    color: var(--color-white);
    cursor: pointer;
    background: var(--color-slate-800);
    border: 0;
    border-radius: var(--radius);
    transition: background-color var(--duration-fast);

    &:hover {
      background: var(--color-ink);
    }
  }
</style>
