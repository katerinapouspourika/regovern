---
import { localizePath, locales, toLocale, useTranslations } from "@/i18n";

const locale = toLocale(Astro.currentLocale);
const targets = locales
  .filter((lang) => lang !== locale)
  .map((lang) => {
    const t = useTranslations(lang);
    return {
      lang,
      href: localizePath(Astro.url.pathname, lang),
      short: t("language.short"),
      label: t("language.readIn"),
    };
  });
---

{targets.map(({ lang, href, short, label }) => (
  <a class="switcher" href={href} hreflang={lang} lang={lang}>
    <span aria-hidden="true">{short}</span>
    <span class="visually-hidden">{label}</span>
  </a>
))}

<style>
  .switcher {
    display: inline-grid;
    place-items: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-inline: var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-white);
    text-decoration: none;
    letter-spacing: 0.04em;
    background: var(--color-slate-800);
    border-radius: var(--radius);
    transition: background-color var(--duration-fast);

    &:hover {
      background: var(--color-ink);
    }
  }
</style>
