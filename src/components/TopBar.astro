---
import Icon from "@/components/Icon.astro";
import { company, emailHref, phoneHref } from "@/data/company";
import { toLocale, useTranslations } from "@/i18n";

const t = useTranslations(toLocale(Astro.currentLocale));
---

<div class="top-bar">
  <div class="container inner">
    <ul class="contacts">
      <li>
        <a href={phoneHref}>
          <Icon name="phone" size={16} />
          <span class="visually-hidden">{t("contact.phone")}:</span>
          {company.phone}
        </a>
      </li>
      <li>
        <a href={emailHref}>
          <Icon name="mail" size={16} />
          <span class="visually-hidden">{t("contact.email")}:</span>
          {company.email}
        </a>
      </li>
    </ul>
    <p class="hours">
      <Icon name="clock" size={16} />
      <span class="visually-hidden">{t("contact.hours")}:</span>
      {t("company.hours")}
    </p>
  </div>
</div>

<style>
  .top-bar {
    --color-focus: var(--color-gold-300);

    font-size: var(--font-size-sm);
    color: var(--color-surface);
    background: var(--color-navy-900);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a,
  .hours {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
  }

  a {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--color-gold-300);
    }
  }

  svg {
    flex-shrink: 0;
    color: var(--color-gold-500);
  }

  /* Office hours only fit beside the contacts on wider screens. */
  .hours {
    display: none;

    @media (width >= 48rem) {
      display: inline-flex;
    }
  }
</style>
