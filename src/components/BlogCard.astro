---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate, toLocale, useTranslations } from "@/i18n";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  cover: ImageMetadata;
  coverAlt: string;
  /** Heading level, so the card fits the page outline. */
  headingLevel?: "h2" | "h3";
}

const {
  href,
  title,
  description,
  date,
  cover,
  coverAlt,
  headingLevel: Heading = "h3",
} = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<article class="blog-card">
  <Image
    src={cover}
    alt={coverAlt}
    widths={[400, 800]}
    sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw"
  />
  <div class="body">
    <time datetime={date.toISOString().slice(0, 10)}>
      {formatDate(date, locale)}
    </time>
    <Heading class="title">
      <a href={href}>{title}</a>
    </Heading>
    <p>{description}</p>
    <span class="more" aria-hidden="true">
      {t("blog.readMore")}
    </span>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition: translate var(--duration-base);

    &:hover {
      translate: 0 -0.25rem;
    }

    &:focus-within {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }
  }

  img {
    inline-size: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  time {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .title {
    font-size: var(--font-size-xl);
  }

  a {
    color: inherit;
    text-decoration: none;

    /* Stretch the title link over the card. */
    &::after {
      position: absolute;
      inset: 0;
      content: "";
    }

    &:focus-visible {
      outline: none;
    }
  }

  p {
    color: var(--color-text-muted);
  }

  .more {
    font-weight: 600;
    color: var(--color-navy-900);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-500);
    text-underline-offset: 0.3em;
  }
</style>
