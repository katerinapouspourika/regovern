{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,

    /* Import alias: "@/foo" resolves to "src/foo" */
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
